{
  "name": "bashio",
  "version": "0.4.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "description": "Natural language to shell commands. Stop Googling, start doing.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "b": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "shell",
    "ai",
    "natural-language",
    "terminal",
    "command-line"
  ],
  "author": {
    "name": "Vranda Garg",
    "url": "https://vrandagarg.in"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/VrandaaGarg/bashio"
  },
  "homepage": "https://github.com/VrandaaGarg/bashio#readme",
  "bugs": {
    "url": "https://github.com/VrandaaGarg/bashio/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "better-sqlite3": "^12.6.0",
    "clipanion": "4.0.0-rc.4",
    "dotenv": "^17.2.3",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.3.5"
  }
}
